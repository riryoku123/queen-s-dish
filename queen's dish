<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <meta name="theme-color" content="#560D21" />
  <title>Queen's Dish — Royal Kitchen PWA</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet" />
  <style>
    /* =====================================================================
       1. DESIGN TOKENS & VARIABEL TEMA (LIGHT & DARK MODE)
       ===================================================================== */
    :root {
      --sidebar-w: 272px;
      --burgundy-grad: linear-gradient(165deg, #6E112B 0%, #4A0A1C 58%, #2E0510 100%);
      --gold-shiny: linear-gradient(135deg, #BF953F 0%, #FCF6BA 35%, #B38728 65%, #FBF5B7 88%, #AA771C 100%);
      --gold-shiny-horiz: linear-gradient(90deg, transparent 0%, #BF953F 20%, #FCF6BA 50%, #BF953F 80%, transparent 100%);
      --ivory-text: #FAF6EE;

      /* Light Mode (Ivory Royal) */
      --bg-page: #FAF6EE;
      --bg-surface: #FFFFFF;
      --bg-surface-alt: #F3ECE0;
      --border-soft: #E5D9C5;
      --text-main: #2A0812;
      --text-muted: #6E585E;
      --shadow-card: 0 6px 22px rgba(58, 10, 23, 0.07);
      --accent-burgundy: #5E0E24;
      --accent-gold-border: #D4AF37;
      --app-zoom: 1;
    }

    body.dark-theme {
      --bg-page: #16070C;
      --bg-surface: #220B12;
      --bg-surface-alt: #2D0F18;
      --border-soft: #471A27;
      --text-main: #FAF4EB;
      --text-muted: #C6AEB4;
      --shadow-card: 0 8px 26px rgba(0, 0, 0, 0.38);
      --accent-burgundy: #8E1B3B;
      --accent-gold-border: #D4AF37;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    html {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg-page);
      color: var(--text-main);
      scroll-behavior: smooth;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      min-height: 100vh;
      overflow-x: hidden;
      transition: background-color 0.25s ease, color 0.25s ease;
    }

    button, input, select, textarea {
      font-family: inherit;
    }

    button {
      cursor: pointer;
    }

    .hidden {
      display: none !important;
    }

    /* Teks Gold Shiny */
    .gold-shiny-text {
      font-family: 'Playfair Display', 'Inter', serif;
      background: var(--gold-shiny);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      text-shadow: 0 1px 12px rgba(252, 246, 186, 0.14);
    }

    /* =====================================================================
       2. SIDEBAR DESKTOP & MOBILE DRAWER (PRESERVED CORE STYLES)
       ===================================================================== */
    /* Sidebar Desktop (Burgundy dengan Garis Batas Kanan Gold Shiny) */
    #desktop-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: var(--sidebar-w);
      background: var(--burgundy-grad);
      color: var(--ivory-text);
      border-right: 2px solid transparent;
      border-image: var(--gold-shiny) 1;
      display: none;
      flex-direction: column;
      justify-content: space-between;
      z-index: 45;
      box-shadow: 6px 0 28px rgba(42, 6, 16, 0.28);
      transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      overflow-y: auto;
    }

    /* Drawer/Sidebar Mode pada Layar Kecil (< 768px) saat Diaktifkan */
    @media (max-width: 767px) {
      body.mobile-drawer-open #desktop-sidebar {
        display: flex;
        transform: translateX(0);
      }
      body:not(.mobile-drawer-open) #desktop-sidebar {
        display: flex;
        transform: translateX(-105%);
      }
    }

    @media (min-width: 768px) {
      #desktop-sidebar {
        display: flex;
      }
      body.nav-hidden #desktop-sidebar {
        transform: translateX(-100%);
      }
    }

    #mobile-drawer-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 40;
      background: rgba(24, 4, 10, 0.62);
      backdrop-filter: blur(2px);
      -webkit-backdrop-filter: blur(2px);
    }

    @media (max-width: 767px) {
      body.mobile-drawer-open #mobile-drawer-backdrop {
        display: block;
      }
    }

    .sidebar-brand {
      padding: 1.15rem 1.15rem;
      border-bottom: 1.5px solid transparent;
      border-image: var(--gold-shiny-horiz) 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.65rem;
      background: rgba(34, 4, 12, 0.28);
    }

    .brand-logo-wrap {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      min-width: 0;
    }

    .crown-badge {
      width: 2.35rem;
      height: 2.35rem;
      border-radius: 0.75rem;
      background: var(--gold-shiny);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 3px 12px rgba(252, 246, 186, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.6);
    }

    .btn-icon-dark {
      width: 2.15rem;
      height: 2.15rem;
      border-radius: 0.65rem;
      background: rgba(250, 246, 238, 0.08);
      border: 1px solid rgba(252, 246, 186, 0.28);
      color: #FCF6BA;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: background 0.18s ease, transform 0.14s ease;
    }

    .btn-icon-dark:hover {
      background: rgba(252, 246, 186, 0.18);
    }

    .btn-icon-dark:active {
      transform: scale(0.95);
    }

    .sidebar-nav {
      padding: 1rem 0.85rem;
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
    }

    .nav-btn-desktop {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.78rem 0.92rem;
      border-radius: 0.85rem;
      border: 1px solid transparent;
      background: transparent;
      color: rgba(250, 246, 238, 0.84);
      font-size: 0.9rem;
      font-weight: 600;
      transition: all 0.2s ease;
    }

    .nav-btn-desktop:hover {
      background: rgba(250, 246, 238, 0.08);
      color: #FCF6BA;
    }

    .nav-btn-desktop.active {
      background: linear-gradient(135deg, rgba(212, 175, 55, 0.24) 0%, rgba(252, 246, 186, 0.12) 100%);
      border-color: rgba(252, 246, 186, 0.55);
      color: #FCF6BA;
      box-shadow: 0 4px 16px rgba(24, 3, 9, 0.35);
    }

    .sidebar-footer {
      margin: 0.85rem;
      padding: 0.9rem;
      border-radius: 1rem;
      background: rgba(30, 4, 11, 0.45);
      border: 1.25px solid transparent;
      background-image: linear-gradient(rgba(36, 5, 13, 0.92), rgba(36, 5, 13, 0.92)), var(--gold-shiny);
      background-origin: border-box;
      background-clip: padding-box, border-box;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .sidebar-control-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      padding: 0.48rem 0.6rem;
      border-radius: 0.75rem;
      background: rgba(250, 246, 238, 0.06);
      border: 1px solid rgba(252, 246, 186, 0.22);
    }

    .sidebar-control-label {
      font-size: 0.74rem;
      font-weight: 700;
      color: rgba(252, 246, 186, 0.9);
    }

    .zoom-box-dark {
      display: inline-flex;
      align-items: center;
      background: rgba(22, 3, 8, 0.6);
      border: 1px solid rgba(252, 246, 186, 0.28);
      border-radius: 0.55rem;
      overflow: hidden;
    }

    .zoom-step-btn {
      background: transparent;
      border: none;
      color: #FCF6BA;
      font-weight: 800;
      font-size: 0.85rem;
      padding: 0.25rem 0.55rem;
    }

    .zoom-step-btn:hover {
      background: rgba(252, 246, 186, 0.14);
    }

    .zoom-val-btn {
      background: transparent;
      border: none;
      border-left: 1px solid rgba(252, 246, 186, 0.2);
      border-right: 1px solid rgba(252, 246, 186, 0.2);
      font-size: 0.72rem;
      font-weight: 800;
      padding: 0.25rem 0.48rem;
    }

    .sidebar-theme-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.35rem 0.65rem;
      border-radius: 0.55rem;
      background: var(--gold-shiny);
      color: #3D0916;
      border: 1px solid #FCF6BA;
      font-size: 0.72rem;
      font-weight: 800;
      box-shadow: 0 2px 10px rgba(252, 246, 186, 0.25);
    }

    /* =====================================================================
       3. MAIN CONTENT WRAPPER, TOPBARS & BOTTOM NAVIGATION
       ===================================================================== */
    .app-shell {
      min-height: 100vh;
      width: 100%;
    }

    #main-content-wrapper {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      transition: margin-left 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      padding-bottom: 5.5rem;
    }

    @media (min-width: 768px) {
      #main-content-wrapper {
        margin-left: var(--sidebar-w);
        padding-bottom: 2.5rem;
      }
      body.nav-hidden #main-content-wrapper {
        margin-left: 0;
      }
    }

    /* Desktop Topbar */
    #desktop-topbar {
      display: none;
    }

    @media (min-width: 768px) {
      #desktop-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.85rem 1.5rem;
        background: var(--bg-surface);
        border-bottom: 1px solid var(--border-soft);
        position: sticky;
        top: 0;
        z-index: 30;
      }
    }

    /* Mobile Topbar */
    #mobile-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      padding: 0.72rem 0.9rem;
      background: var(--burgundy-grad);
      color: var(--ivory-text);
      border-bottom: 2px solid transparent;
      border-image: var(--gold-shiny-horiz) 1;
      position: sticky;
      top: 0;
      z-index: 32;
      box-shadow: 0 4px 18px rgba(34, 4, 12, 0.26);
    }

    @media (min-width: 768px) {
      #mobile-topbar {
        display: none;
      }
    }

    /* Mobile Bottom Navigation */
    #mobile-bottom-nav {
      position: fixed;
      left: 0.75rem;
      right: 0.75rem;
      bottom: 0.75rem;
      z-index: 35;
      background: var(--burgundy-grad);
      border: 1.5px solid #D4AF37;
      border-radius: 1.15rem;
      padding: 0.42rem;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.35rem;
      box-shadow: 0 12px 30px rgba(28, 3, 10, 0.42);
      transition: transform 0.26s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.22s ease;
    }

    @media (min-width: 768px) {
      #mobile-bottom-nav {
        display: none;
      }
    }

    body.nav-hidden #mobile-bottom-nav {
      transform: translateY(135%);
      opacity: 0;
      pointer-events: none;
    }

    .nav-btn-mobile {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.2rem;
      padding: 0.48rem 0.35rem;
      border-radius: 0.85rem;
      border: 1px solid transparent;
      background: transparent;
      color: rgba(250, 246, 238, 0.78);
      font-size: 0.72rem;
      font-weight: 700;
      position: relative;
      transition: all 0.2s ease;
    }

    .nav-btn-mobile.active {
      background: linear-gradient(135deg, rgba(212, 175, 55, 0.28), rgba(252, 246, 186, 0.14));
      border-color: rgba(252, 246, 186, 0.6);
      color: #FCF6BA;
    }

    /* Indikator Visual Swipe Horizontal pada Konten Utama */
    #swipe-edge-indicator {
      position: fixed;
      top: 50%;
      transform: translateY(-50%);
      z-index: 42;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.16s ease, transform 0.16s ease;
      padding: 0.55rem 0.85rem;
      border-radius: 999px;
      background: var(--burgundy-grad);
      color: #FCF6BA;
      border: 1.5px solid #D4AF37;
      font-size: 0.76rem;
      font-weight: 800;
      box-shadow: 0 10px 25px rgba(34, 4, 12, 0.45), 0 0 14px rgba(212, 175, 55, 0.32);
    }
    #swipe-edge-indicator.left {
      left: 1rem;
    }
    #swipe-edge-indicator.right {
      right: 1rem;
    }
    #swipe-edge-indicator.visible {
      opacity: 1;
    }

    /* Tombol Floating Show Navigasi di HP saat disembunyikan */
    #floating-show-nav-btn {
      display: none;
      position: fixed;
      right: 1rem;
      bottom: 1rem;
      z-index: 36;
      padding: 0.6rem 0.95rem;
      border-radius: 999px;
      background: var(--burgundy-grad);
      color: #FCF6BA;
      border: 1.5px solid #D4AF37;
      font-size: 0.76rem;
      font-weight: 800;
      box-shadow: 0 8px 24px rgba(28, 3, 10, 0.45);
      align-items: center;
      gap: 0.4rem;
    }

    @media (max-width: 767px) {
      body.nav-hidden #floating-show-nav-btn {
        display: inline-flex;
      }
    }

    /* =====================================================================
       4. KOMPONEN UI UMUM (BUTTONS, BADGES, CARDS, STEPPERS, MODALS)
       ===================================================================== */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.42rem;
      padding: 0.58rem 0.95rem;
      border-radius: 0.75rem;
      font-size: 0.82rem;
      font-weight: 700;
      border: 1px solid transparent;
      transition: transform 0.14s ease, box-shadow 0.2s ease, opacity 0.2s ease;
    }

    .btn:active {
      transform: scale(0.97);
    }

    .btn-primary {
      background: var(--burgundy-grad);
      color: #FCF6BA;
      border-color: #D4AF37;
      box-shadow: 0 4px 14px rgba(74, 10, 28, 0.24);
    }

    .btn-gold {
      background: var(--gold-shiny);
      color: #3D0916;
      border-color: #FCF6BA;
      box-shadow: 0 4px 14px rgba(191, 149, 63, 0.28);
    }

    .btn-secondary {
      background: var(--bg-surface-alt);
      color: var(--text-main);
      border-color: var(--border-soft);
    }

    .btn-danger {
      background: rgba(225, 29, 72, 0.12);
      color: #E11D48;
      border-color: rgba(225, 29, 72, 0.35);
    }

    .mini-tabs-wrap {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.25rem;
      border-radius: 0.75rem;
      background: var(--bg-surface-alt);
      border: 1px solid var(--border-soft);
    }

    .mini-tab-btn {
      padding: 0.35rem 0.75rem;
      border-radius: 0.55rem;
      border: none;
      background: transparent;
      color: var(--text-muted);
      font-size: 0.76rem;
      font-weight: 700;
    }

    .mini-tab-btn.active {
      background: var(--burgundy-grad);
      color: #FCF6BA;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.18rem 0.55rem;
      border-radius: 999px;
      font-size: 0.7rem;
      font-weight: 800;
    }

    .badge-rose {
      background: #E11D48;
      color: #FFFFFF;
    }

    .badge-emerald {
      background: rgba(16, 185, 129, 0.15);
      color: #059669;
      border: 1px solid rgba(16, 185, 129, 0.35);
    }

    body.dark-theme .badge-emerald {
      color: #34D399;
    }

    .badge-amber {
      background: rgba(245, 158, 11, 0.16);
      color: #B45309;
      border: 1px solid rgba(245, 158, 11, 0.35);
    }

    body.dark-theme .badge-amber {
      color: #FBBF24;
    }

    .badge-neutral {
      background: var(--bg-surface-alt);
      color: var(--text-main);
      border: 1px solid var(--border-soft);
    }

    /* Zoomable Content Area */
    #zoomable-stage {
      width: 100%;
      max-width: 1180px;
      margin: 0 auto;
      padding: 1.15rem;
      zoom: var(--app-zoom);
    }

    @media (min-width: 768px) {
      #zoomable-stage {
        padding: 1.6rem 1.8rem;
      }
    }

    .view-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.85rem;
      margin-bottom: 1.25rem;
    }

    .view-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.55rem;
      font-weight: 800;
      color: var(--text-main);
      line-height: 1.2;
    }

    .view-subtitle {
      font-size: 0.82rem;
      color: var(--text-muted);
      margin-top: 0.2rem;
    }

    /* Stats Strip */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }

    .stat-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-soft);
      border-radius: 1rem;
      padding: 0.9rem 1rem;
      box-shadow: var(--shadow-card);
    }

    .stat-label {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .stat-value {
      font-size: 1.45rem;
      font-weight: 800;
      margin-top: 0.2rem;
      color: var(--text-main);
    }

    /* Filter Bar */
    .toolbar-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      margin-bottom: 1.15rem;
    }

    .input-field, .select-field {
      background: var(--bg-surface);
      color: var(--text-main);
      border: 1px solid var(--border-soft);
      border-radius: 0.75rem;
      padding: 0.6rem 0.85rem;
      font-size: 0.85rem;
      outline: none;
      transition: border-color 0.2s ease;
    }

    .input-field:focus, .select-field:focus {
      border-color: #D4AF37;
    }

    /* Cards Grid */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 0.95rem;
    }

    .royal-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-soft);
      border-radius: 1.05rem;
      padding: 1.05rem;
      box-shadow: var(--shadow-card);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0.8rem;
      transition: transform 0.18s ease, border-color 0.2s ease;
    }

    .royal-card:hover {
      border-color: rgba(212, 175, 55, 0.75);
    }

    .royal-card.low-stock {
      border-left: 4px solid #E11D48;
    }

    .royal-card.ready-recipe {
      border-top: 3px solid #D4AF37;
    }

    /* Quantity Stepper */
    .qty-stepper {
      display: inline-flex;
      align-items: center;
      background: var(--bg-surface-alt);
      border: 1px solid var(--border-soft);
      border-radius: 0.7rem;
      overflow: hidden;
    }

    .qty-stepper button {
      width: 2.1rem;
      height: 2.1rem;
      border: none;
      background: transparent;
      color: var(--text-main);
      font-size: 1rem;
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .qty-stepper button:hover {
      background: rgba(212, 175, 55, 0.18);
    }

    .qty-stepper span {
      padding: 0 0.65rem;
      font-size: 0.84rem;
      font-weight: 800;
      min-width: 4.5rem;
      text-align: center;
    }

    /* Compact Log Table for Stock */
    .log-section-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.65rem;
      margin-bottom: 0.65rem;
    }

    .log-title-group {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.96rem;
      font-weight: 800;
      color: var(--text-main);
    }

    .log-table-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-soft);
      border-radius: 1rem;
      box-shadow: var(--shadow-card);
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .log-table {
      width: 100%;
      border-collapse: collapse;
      min-width: 820px;
      text-align: left;
    }

    .log-table thead {
      background: var(--bg-surface-alt);
      border-bottom: 1.5px solid var(--border-soft);
    }

    .log-table th {
      padding: 0.58rem 0.75rem;
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--text-muted);
      white-space: nowrap;
      vertical-align: top;
    }

    .th-filter-stack {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .th-inline-input,
    .th-inline-select {
      width: 100%;
      min-width: 105px;
      background: var(--bg-surface);
      color: var(--text-main);
      border: 1px solid var(--border-soft);
      border-radius: 0.5rem;
      padding: 0.32rem 0.5rem;
      font-size: 0.74rem;
      font-weight: 500;
      text-transform: none;
      letter-spacing: normal;
      outline: none;
      transition: border-color 0.18s ease, box-shadow 0.18s ease;
    }

    .th-inline-input:focus,
    .th-inline-select:focus {
      border-color: #D4AF37;
      box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.18);
    }

    .log-note-input {
      width: 100%;
      min-width: 165px;
      background: var(--bg-surface-alt);
      color: var(--text-main);
      border: 1px solid var(--border-soft);
      border-radius: 0.55rem;
      padding: 0.34rem 0.58rem;
      font-size: 0.78rem;
      outline: none;
      transition: border-color 0.18s ease, background-color 0.18s ease;
    }

    .log-note-input:focus {
      background: var(--bg-surface);
      border-color: #D4AF37;
    }

    .log-table thead {
      background: var(--bg-surface-alt);
      border-bottom: 1.5px solid var(--border-soft);
    }

    .log-table th {
      padding: 0.62rem 0.85rem;
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--text-muted);
      white-space: nowrap;
    }

    .log-table tbody tr {
      border-bottom: 1px solid var(--border-soft);
      transition: background-color 0.16s ease;
    }

    .log-table tbody tr:last-child {
      border-bottom: none;
    }

    .log-table tbody tr:hover {
      background-color: rgba(212, 175, 55, 0.06);
    }

    .log-table tbody tr.low-stock-row {
      background-color: rgba(225, 29, 72, 0.04);
    }

    .log-table td {
      padding: 0.58rem 0.85rem;
      font-size: 0.84rem;
      vertical-align: middle;
      white-space: nowrap;
    }

    .log-row-num {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-weight: 800;
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .log-name-cell {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-weight: 700;
      color: var(--text-main);
    }

    .log-inline-edit-btn {
      background: transparent;
      border: 1px solid transparent;
      color: inherit;
      font-weight: 700;
      font-size: 0.85rem;
      padding: 0.18rem 0.38rem;
      border-radius: 0.45rem;
      text-align: left;
      transition: border-color 0.16s ease, background-color 0.16s ease;
    }

    .log-inline-edit-btn:hover {
      border-color: var(--border-soft);
      background: var(--bg-surface-alt);
    }

    .qty-stepper-compact {
      display: inline-flex;
      align-items: center;
      background: var(--bg-surface-alt);
      border: 1px solid var(--border-soft);
      border-radius: 0.55rem;
      overflow: hidden;
    }

    .qty-stepper-compact button {
      width: 1.75rem;
      height: 1.75rem;
      border: none;
      background: transparent;
      color: var(--text-main);
      font-size: 0.9rem;
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .qty-stepper-compact button:hover {
      background: rgba(212, 175, 55, 0.2);
    }

    .qty-val-trigger {
      border: none;
      border-left: 1px solid var(--border-soft);
      border-right: 1px solid var(--border-soft);
      background: transparent;
      padding: 0.18rem 0.55rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.8rem;
      font-weight: 800;
      min-width: 5.2rem;
      text-align: center;
      cursor: pointer;
    }

    .qty-val-trigger.safe {
      color: #059669;
    }

    body.dark-theme .qty-val-trigger.safe {
      color: #34D399;
    }

    .qty-val-trigger.low {
      color: #E11D48;
    }

    body.dark-theme .qty-val-trigger.low {
      color: #FB7185;
    }

    /* Modals */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 60;
      background: rgba(20, 3, 8, 0.68);
      backdrop-filter: blur(3px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }

    .modal-card {
      width: 100%;
      max-width: 480px;
      max-height: 90vh;
      overflow-y: auto;
      background: var(--bg-surface);
      color: var(--text-main);
      border: 1.5px solid #D4AF37;
      border-radius: 1.2rem;
      padding: 1.25rem;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
    }

    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border-soft);
      padding-bottom: 0.75rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.32rem;
    }

    .form-label {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--text-muted);
    }

    /* Toast Notification */
    #royal-toast {
      position: fixed;
      top: 1rem;
      left: 50%;
      transform: translateX(-50%) translateY(-140%);
      z-index: 80;
      background: var(--burgundy-grad);
      color: #FCF6BA;
      border: 1.5px solid #D4AF37;
      padding: 0.65rem 1.15rem;
      border-radius: 999px;
      font-size: 0.82rem;
      font-weight: 700;
      box-shadow: 0 10px 28px rgba(24, 3, 9, 0.45);
      transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
      text-align: center;
      max-width: 92vw;
    }

    #royal-toast.show {
      transform: translateX(-50%) translateY(0);
    }
  </style>
</head>
<body>
