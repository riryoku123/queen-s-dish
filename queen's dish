    function checkRecipeAvailability(recipe) {
      if (!recipe || !Array.isArray(recipe.ingredients) || !recipe.ingredients.length) {
        return { ready: true, missingItems: [] };
      }
      const missingItems = [];
      recipe.ingredients.forEach((ing) => {
        const stockItem = appState.stock.find((s) => s.id === ing.stockId);
        const needed = Number(ing.amount) || 0;
        const available = stockItem ? Number(stockItem.qty) || 0 : 0;
        if (!stockItem || available < needed) {
          missingItems.push({
            name: stockItem ? stockItem.name : "Bahan tidak ditemukan",
            unit: stockItem ? stockItem.unit : "",
            needed,
            available
          });
        }
      });
      return { ready: missingItems.length === 0, missingItems };
    }

    function cookRecipeNow(recipeId) {
      const recipe = appState.recipes.find((r) => r.id === recipeId);
      if (!recipe) return;
      const check = checkRecipeAvailability(recipe);
      if (!check.ready) {
        showToast("Bahan belum cukup untuk memasak menu ini");
        return;
      }
      recipe.ingredients.forEach((ing) => {
        const stockItem = appState.stock.find((s) => s.id === ing.stockId);
        if (stockItem) {
          stockItem.qty = Math.max(0, Number((stockItem.qty - Number(ing.amount || 0)).toFixed(2)));
        }
      });
      saveAppState();
      renderAllViews();
      showToast(`${recipe.name} dimasak & stok bahan diperbarui`);
    }

