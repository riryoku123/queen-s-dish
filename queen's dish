        { id: "stk-8", name: "Wortel Organik", category: "Sayur & Buah", qty: 250, minQty: 100, unit: "gram", notes: "Simpan di chiller sayur" }
      ],
      recipes: [
        {
          id: "rec-1",
          name: "Nasi Goreng Kerajaan",
          tag: "Hidangan Utama",
          prepMinutes: 20,
          ingredients: [
            { stockId: "stk-1", amount: 300 },
            { stockId: "stk-3", amount: 2 },
            { stockId: "stk-4", amount: 20 },
            { stockId: "stk-6", amount: 3 },
            { stockId: "stk-5", amount: 30 }
