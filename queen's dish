  <script>
    /* =====================================================================
       1. KONSTANTA STORAGE & DATA DEFAULT ROYAL KITCHEN
       ===================================================================== */
    const STORAGE_KEY = "queens_dish_data_v1";
    const NAV_HIDDEN_KEY = "queens_dish_nav_hidden";
    const THEME_KEY = "queens_dish_theme";
    const ZOOM_KEY = "queens_dish_zoom";

    const DEFAULT_STATE = {
      stock: [
