                </div>
                <h3 style="font-size:1.05rem;font-weight:800;margin-bottom:0.55rem;">${escapeHtml(recipe.name)}</h3>
                <div style="display:flex;flex-wrap:wrap;gap:0.35rem;">
                  ${ingBadges || '<span style="font-size:0.78rem;color:var(--text-muted);">Tanpa rincian bahan</span>'}
                </div>
              </div>

              <div style="display:flex;gap:0.5rem;padding-top:0.65rem;border-top:1px solid var(--border-soft);">
                <button
                  type="button"
                  onclick="cookRecipeNow('${recipe.id}')"
                  class="btn ${availability.ready ? "btn-primary" : "btn-secondary"}"
                  style="flex:1;${availability.ready ? "" : "opacity:0.65;"}"
                  ${availability.ready ? "" : "disabled"}
                >
                  🍳 Masak Sekarang
                </button>
                <button type="button" onclick="deleteRecipeItem('${recipe.id}')" class="btn btn-danger" style="padding:0.5rem 0.7rem;">
                  Hapus
                </button>
              </div>
            </article>
          `;
        })
        .join("");
    }

    /* =====================================================================
       7. LOGIKA VIEW 3: SCHEDULE MASAK
       ===================================================================== */
    function openAddScheduleModal() {
      const sel = document.getElementById("schedule-recipe-input");
      if (!appState.recipes.length) {
        showToast("Tambahkan resep di tab Makanan terlebih dahulu");
        return;
      }
      sel.innerHTML = appState.recipes
        .map((r) => `<option value="${r.id}">${escapeHtml(r.name)}</option>`)
        .join("");
      document.getElementById("schedule-date-input").value = new Date().toISOString().split("T")[0];
      document.getElementById("schedule-note-input").value = "";
      openModal("modal-schedule");
    }

    function handleSaveSchedule(e) {
      e.preventDefault();
      const date = document.getElementById("schedule-date-input").value;
      const meal = document.getElementById("schedule-meal-input").value;
      const recipeId = document.getElementById("schedule-recipe-input").value;
      const note = document.getElementById("schedule-note-input").value.trim();

      if (!date || !recipeId) return;
      appState.schedule.push({
        id: "sch-" + Date.now(),
        date,
        meal,
        recipeId,
        note,
        done: false
      });
      saveAppState();
      closeModal("modal-schedule");
      renderScheduleView();
      showToast("Jadwal masak berhasil ditambahkan");
    }

    function toggleScheduleDone(id) {
      const item = appState.schedule.find((s) => s.id === id);
      if (!item) return;
      item.done = !item.done;
      saveAppState();
      renderScheduleView();
    }

    function deleteScheduleItem(id) {
      appState.schedule = appState.schedule.filter((s) => s.id !== id);
      saveAppState();
      renderScheduleView();
      showToast("Jadwal dihapus");
    }

    function renderScheduleView() {
      const activeCount = appState.schedule.filter((s) => !s.done).length;
      const statsGrid = document.getElementById("schedule-stats-grid");
      if (statsGrid) {
        statsGrid.innerHTML = `
          <div class="stat-card">
            <div class="stat-label">Total Jadwal</div>
            <div class="stat-value">${appState.schedule.length}</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Menunggu Dimasak</div>
            <div class="stat-value" style="color:#B45309;">${activeCount}</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Selesai Disajikan</div>
            <div class="stat-value" style="color:#059669;">${appState.schedule.length - activeCount}</div>
          </div>
        `;
      }

      const container = document.getElementById("schedule-list-container");
      if (!container) return;

      if (!appState.schedule.length) {
        container.innerHTML = `<div class="royal-card" style="grid-column:1/-1;text-align:center;padding:2rem;color:var(--text-muted);">Belum ada jadwal menu. Klik "+ Jadwalkan Menu" untuk memulai.</div>`;
        return;
      }

      const sorted = [...appState.schedule].sort((a, b) => a.date.localeCompare(b.date));
      container.innerHTML = sorted
        .map((item) => {
          const recipe = appState.recipes.find((r) => r.id === item.recipeId);
          const recipeName = recipe ? recipe.name : "Menu Terhapus";
          return `
            <article class="royal-card" style="opacity:${item.done ? "0.72" : "1"};">
              <div>
                <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-bottom:0.45rem;">
                  <span class="badge badge-neutral">📅 ${escapeHtml(item.date)} • ${escapeHtml(item.meal)}</span>
                  ${
                    item.done
                      ? `<span class="badge badge-emerald">Selesai</span>`
                      : `<span class="badge badge-amber">Terjadwal</span>`
                  }
                </div>
                <h3 style="font-size:1.05rem;font-weight:800;text-decoration:${
                  item.done ? "line-through" : "none"
                };">${escapeHtml(recipeName)}</h3>
                ${
                  item.note
                    ? `<p style="font-size:0.8rem;color:var(--text-muted);margin-top:0.35rem;">📝 ${escapeHtml(item.note)}</p>`
                    : ""
                }
              </div>

              <div style="display:flex;gap:0.5rem;padding-top:0.55rem;border-top:1px solid var(--border-soft);">
                <button type="button" onclick="toggleScheduleDone('${item.id}')" class="btn ${
            item.done ? "btn-secondary" : "btn-gold"
          }" style="flex:1;">
                  ${item.done ? "↩ Batal Selesai" : "✓ Tandai Selesai"}
                </button>
                <button type="button" onclick="deleteScheduleItem('${item.id}')" class="btn btn-danger" style="padding:0.5rem 0.7rem;">
                  Hapus
                </button>
              </div>
            </article>
          `;
        })
        .join("");
    }

    /* =====================================================================
       8. SINKRONISASI BADGE SIDEBAR & INISIALISASI
       ===================================================================== */
    function updateSidebarCounters() {
      const lowCount = appState.stock.filter((s) => s.qty <= s.minQty).length;
      const alertBadge = document.getElementById("sidebar-stock-alert");
      if (alertBadge) {
        alertBadge.textContent = String(lowCount);
        alertBadge.classList.toggle("hidden", lowCount === 0);
      }

      const readyCount = appState.recipes.filter((r) => checkRecipeAvailability(r).ready).length;
      const readyEl = document.getElementById("sidebar-ready-count");
      if (readyEl) readyEl.textContent = `${readyCount} siap`;

      const schedCount = appState.schedule.filter((s) => !s.done).length;
      const schedEl = document.getElementById("sidebar-schedule-count");
      if (schedEl) schedEl.textContent = `${schedCount} jadwal`;
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function renderAllViews() {
      updateSidebarCounters();
      renderStockView();
      renderRecipesView();
      renderScheduleView();
    }

    // Inisialisasi saat halaman dimuat
    applyTheme();
    applyZoom();
    applyNavVisibility();
    renderAllViews();
  </script>
</body>
</html>
