          name: "Ayam Tumis Bawang Putih & Wortel",
          tag: "Hidangan Utama",
          prepMinutes: 25,
          ingredients: [
            { stockId: "stk-2", amount: 350 },
            { stockId: "stk-4", amount: 25 },
            { stockId: "stk-8", amount: 120 },
            { stockId: "stk-5", amount: 25 }
          ]
        },
        {
          id: "rec-3",
          name: "Opor Ayam Santan Klasik",
          tag: "Hidangan Utama",
          prepMinutes: 40,
          ingredients: [
            { stockId: "stk-2", amount: 500 },
            { stockId: "stk-7", amount: 2 },
            { stockId: "stk-4", amount: 30 }
          ]
        },
        {
          id: "rec-4",
          name: "Telur Dadar Golden Royal",
          tag: "Sarapan",
          prepMinutes: 10,
          ingredients: [
            { stockId: "stk-3", amount: 3 },
            { stockId: "stk-5", amount: 20 }
          ]
        }
      ],
      schedule: [
        {
          id: "sch-1",
          date: new Date().toISOString().split("T")[0],
          meal: "Sarapan",
          recipeId: "rec-4",
          note: "Sajikan hangat dengan teh melati",
          done: false
        },
        {
          id: "sch-2",
          date: new Date().toISOString().split("T")[0],
          meal: "Makan Malam",
          recipeId: "rec-1",
          note: "Porsi keluarga (3 piring)",
          done: false
        }
      ]
    };

    function loadAppState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (parsed && Array.isArray(parsed.stock) && Array.isArray(parsed.recipes) && Array.isArray(parsed.schedule)) {
            parsed.stock = parsed.stock.map((item) => ({
              ...item,
              notes: typeof item.notes === "string" ? item.notes : ""
            }));
            return parsed;
          }
        }
      } catch (e) {}
      return JSON.parse(JSON.stringify(DEFAULT_STATE));
    }

    let appState = loadAppState();
    let currentTab = "stock";
    let deferredPrompt = null;

    function saveAppState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
      } catch (e) {}
      updateSidebarCounters();
    }

    function showToast(message) {
      const toast = document.getElementById("royal-toast");
      if (!toast) return;
      toast.textContent = message;
      toast.classList.add("show");
      clearTimeout(toast._timer);
      toast._timer = setTimeout(() => {
        toast.classList.remove("show");
      }, 2500);
    }

    /* =====================================================================
       2. TEMA GELAP/TERANG, ZOOM & NAV VISIBILITY
       ===================================================================== */
    let isNavHidden = localStorage.getItem(NAV_HIDDEN_KEY) === "true";
    let isMobileDrawerOpen = false;

    let currentTheme = (() => {
      try {
        return localStorage.getItem(THEME_KEY) || "light";
      } catch (e) {
        return "light";
      }
    })();

    let currentZoom = (() => {
      try {
        const z = parseInt(localStorage.getItem(ZOOM_KEY), 10);
        return !isNaN(z) && z >= 70 && z <= 140 ? z : 100;
      } catch (e) {
        return 100;
      }
    })();

    function applyTheme() {
      const isDark = currentTheme === "dark";
      document.body.classList.toggle("dark-theme", isDark);
      document.querySelectorAll(".theme-icon-text").forEach((el) => {
        el.textContent = isDark ? "☀️" : "🌙";
      });
      document.querySelectorAll(".theme-label-text").forEach((el) => {
        el.textContent = isDark ? "Terang" : "Gelap";
      });
    }

    function toggleTheme() {
      currentTheme = currentTheme === "dark" ? "light" : "dark";
      try {
        localStorage.setItem(THEME_KEY, currentTheme);
      } catch (e) {}
      applyTheme();
    }

    function applyZoom() {
      document.documentElement.style.setProperty("--app-zoom", (currentZoom / 100).toFixed(2));
      document.querySelectorAll(".zoom-percent-text").forEach((el) => {
        el.textContent = `${currentZoom}%`;
      });
    }

    function stepZoom(delta) {
      currentZoom = Math.min(140, Math.max(70, currentZoom + delta));
      try {
        localStorage.setItem(ZOOM_KEY, String(currentZoom));
      } catch (e) {}
      applyZoom();
    }

    function resetZoom() {
      currentZoom = 100;
      try {
        localStorage.setItem(ZOOM_KEY, "100");
      } catch (e) {}
      applyZoom();
      showToast("Zoom direset ke 100%");
    }

    function applyNavVisibility() {
      document.body.classList.toggle("nav-hidden", isNavHidden);

      const desktopText = document.getElementById("desktop-nav-toggle-text");
      const quickTabs = document.getElementById("desktop-quick-tabs");
      const mobileArrow = document.getElementById("mobile-nav-arrow-icon");

      if (desktopText) {
        desktopText.textContent = isNavHidden ? "Tampilkan Sidebar" : "Sembunyikan Sidebar";
      }
      if (quickTabs) {
        quickTabs.classList.toggle("hidden", !isNavHidden);
      }
      if (mobileArrow) {
        mobileArrow.innerHTML = isNavHidden
          ? '<path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>'
          : '<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>';
      }
    }

    function toggleNavVisibility() {
      isNavHidden = !isNavHidden;
      try {
        localStorage.setItem(NAV_HIDDEN_KEY, String(isNavHidden));
      } catch (e) {}
      applyNavVisibility();
    }

    function setMobileDrawer(open) {
      isMobileDrawerOpen = Boolean(open);
      document.body.classList.toggle("mobile-drawer-open", isMobileDrawerOpen);
    }

    function toggleMobileDrawer() {
      setMobileDrawer(!isMobileDrawerOpen);
    }

    function closeMobileDrawer() {
      setMobileDrawer(false);
    }

    function handleSidebarCollapseAction() {
      if (window.innerWidth < 768) {
        closeMobileDrawer();
      } else {
        toggleNavVisibility();
      }
    }

    /* =====================================================================
       3. MODALS & DATA BACKUP
       ===================================================================== */
    function openModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.remove("hidden");
    }

    function closeModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.add("hidden");
    }

    function openDataModal() {
      closeMobileDrawer();
      openModal("modal-data");
    }

    function exportBackupJSON() {
      const payload = {
        app: "Queen's Dish - Royal Kitchen PWA",
        exportedAt: new Date().toISOString(),
        data: appState
      };
      const blob = new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `queens-dish-backup-${new Date().toISOString().slice(0, 10)}.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast("Backup JSON berhasil diunduh");
    }

    function handleImportJSON(event) {
      const file = event.target.files && event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        try {
          const parsed = JSON.parse(e.target.result);
          const imported = parsed.data ? parsed.data : parsed;
          if (Array.isArray(imported.stock) && Array.isArray(imported.recipes) && Array.isArray(imported.schedule)) {
            imported.stock = imported.stock.map((item) => ({
              ...item,
              notes: typeof item.notes === "string" ? item.notes : ""
            }));
            appState = imported;
            saveAppState();
            renderAllViews();
            closeModal("modal-data");
            showToast("Data backup berhasil dipulihkan!");
          } else {
            showToast("Format file JSON tidak valid.");
          }
        } catch (err) {
          showToast("Gagal membaca file JSON.");
        }
        event.target.value = "";
      };
      reader.readAsText(file);
    }

    function resetDemoData() {
      appState = JSON.parse(JSON.stringify(DEFAULT_STATE));
      saveAppState();
      renderAllViews();
      closeModal("modal-data");
      showToast("Data dikembalikan ke contoh awal");
    }

    window.addEventListener("beforeinstallprompt", (e) => {
      e.preventDefault();
      deferredPrompt = e;
      const btn = document.getElementById("install-pwa-btn-desktop");
      if (btn) btn.classList.remove("hidden");
    });

    async function installPWA() {
      if (!deferredPrompt) {
        showToast("Gunakan menu browser 'Add to Home Screen' untuk install");
        return;
      }
      deferredPrompt.prompt();
      await deferredPrompt.userChoice;
      deferredPrompt = null;
    }

    /* =====================================================================
       4. NAVIGASI TAB, SWIPE GESTURE & UTILITAS UMUM
       ===================================================================== */
    const TAB_ORDER = ["stock", "recipes", "schedule"];
    const TAB_LABELS = { stock: "Stock", recipes: "Makanan", schedule: "Schedule" };

    function switchTab(tabName) {
      if (!TAB_ORDER.includes(tabName)) return;
      currentTab = tabName;
      ["stock", "recipes", "schedule"].forEach((t) => {
        const viewEl = document.getElementById(`view-${t}`);
        if (viewEl) {
          viewEl.classList.toggle("hidden", t !== tabName);
        }
      });

      document.querySelectorAll("[data-nav]").forEach((btn) => {
        btn.classList.toggle("active", btn.getAttribute("data-nav") === tabName);
      });

      document.querySelectorAll("[data-mini-nav]").forEach((btn) => {
        btn.classList.toggle("active", btn.getAttribute("data-mini-nav") === tabName);
      });

      const activeLabelEl = document.getElementById("desktop-active-view-label");
      if (activeLabelEl) activeLabelEl.textContent = TAB_LABELS[tabName];

      const mobileSubEl = document.getElementById("mobile-active-view-sub");
      if (mobileSubEl) mobileSubEl.textContent = `${TAB_LABELS[tabName]} • Usap kiri/kanan`;

      if (window.innerWidth < 768) {
        closeMobileDrawer();
      }

      if (tabName === "stock") renderStockView();
      if (tabName === "recipes") renderRecipesView();
      if (tabName === "schedule") renderScheduleView();
    }

    (function setupSwipeNavigation() {
      const mainWrapper = document.getElementById("main-content-wrapper");
      const bottomNav = document.getElementById("mobile-bottom-nav");
      const indicator = document.getElementById("swipe-edge-indicator");
      if (!mainWrapper) return;

      let startX = 0;
      let startY = 0;
      let trackingMainSwipe = false;
      let hideIndicatorTimer = null;

      function showSwipeHint(dir, targetLabel) {
        if (!indicator) return;
        indicator.textContent = dir === "next" ? `→ ${targetLabel}` : `← ${targetLabel}`;
        indicator.classList.remove("left", "right");
        indicator.classList.add(dir === "next" ? "right" : "left", "visible");
        clearTimeout(hideIndicatorTimer);
        hideIndicatorTimer = setTimeout(() => {
          indicator.classList.remove("visible");
        }, 380);
      }

      function isInteractiveTarget(el) {
        return Boolean(
          el &&
          el.closest("input, select, textarea, button, .qty-stepper, .modal-backdrop, #desktop-sidebar")
        );
      }

      mainWrapper.addEventListener(
        "touchstart",
        (e) => {
          if (e.touches.length !== 1 || isInteractiveTarget(e.target)) {
            trackingMainSwipe = false;
            return;
          }
          startX = e.touches[0].clientX;
          startY = e.touches[0].clientY;
          trackingMainSwipe = true;
        },
        { passive: true }
      );

      mainWrapper.addEventListener(
        "touchmove",
        (e) => {
          if (!trackingMainSwipe || e.touches.length !== 1) return;
          const dx = e.touches[0].clientX - startX;
          const dy = e.touches[0].clientY - startY;
          if (Math.abs(dx) > 36 && Math.abs(dx) > Math.abs(dy) * 1.45) {
            const idx = TAB_ORDER.indexOf(currentTab);
            if (dx < 0 && idx < TAB_ORDER.length - 1) {
              showSwipeHint("next", TAB_LABELS[TAB_ORDER[idx + 1]]);
            } else if (dx > 0 && idx > 0) {
              showSwipeHint("prev", TAB_LABELS[TAB_ORDER[idx - 1]]);
            }
          }
        },
        { passive: true }
      );

      mainWrapper.addEventListener(
        "touchend",
        (e) => {
          if (!trackingMainSwipe || !e.changedTouches.length) return;
          trackingMainSwipe = false;
          const endX = e.changedTouches[0].clientX;
          const endY = e.changedTouches[0].clientY;
          const dx = endX - startX;
          const dy = endY - startY;

          // Buka drawer bila mengusap dari tepi kiri layar di HP saat drawer tertutup
          if (window.innerWidth < 768 && !isMobileDrawerOpen && startX < 26 && dx > 68 && Math.abs(dy) < 60) {
            setMobileDrawer(true);
            return;
          }

          if (Math.abs(dx) > 65 && Math.abs(dx) > Math.abs(dy) * 1.5) {
            const idx = TAB_ORDER.indexOf(currentTab);
            if (dx < 0 && idx < TAB_ORDER.length - 1) {
              switchTab(TAB_ORDER[idx + 1]);
            } else if (dx > 0 && idx > 0) {
              switchTab(TAB_ORDER[idx - 1]);
            }
          }
        },
        { passive: true }
      );

      if (bottomNav) {
        let navStartY = 0;
        bottomNav.addEventListener(
          "touchstart",
          (e) => {
            if (e.touches.length === 1) navStartY = e.touches[0].clientY;
          },
          { passive: true }
        );
        bottomNav.addEventListener(
          "touchend",
          (e) => {
            if (!e.changedTouches.length) return;
            const dy = e.changedTouches[0].clientY - navStartY;
            if (dy > 32 && !isNavHidden) {
              toggleNavVisibility();
            }
          },
          { passive: true }
        );
      }

      // Usap ke atas dari bagian bawah layar untuk menampilkan kembali navigasi saat tersembunyi
      let edgeUpStartY = 0;
      let edgeUpStartX = 0;
      document.addEventListener(
        "touchstart",
        (e) => {
          if (!isNavHidden || e.touches.length !== 1) return;
          const y = e.touches[0].clientY;
          if (window.innerHeight - y < 48) {
            edgeUpStartY = y;
            edgeUpStartX = e.touches[0].clientX;
          } else {
            edgeUpStartY = 0;
          }
        },
        { passive: true }
      );
      document.addEventListener(
        "touchend",
        (e) => {
          if (!edgeUpStartY || !e.changedTouches.length) return;
          const dy = edgeUpStartY - e.changedTouches[0].clientY;
          const dx = Math.abs(e.changedTouches[0].clientX - edgeUpStartX);
          edgeUpStartY = 0;
          if (dy > 38 && dx < 60 && isNavHidden) {
            toggleNavVisibility();
          }
        },
        { passive: true }
      );
    })();

